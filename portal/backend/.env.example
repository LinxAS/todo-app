# Copy to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=production

# PostgreSQL — portal's own database (linxas_portal)
PGHOST=localhost
PGPORT=5432
PGDATABASE=linxas_portal
PGUSER=portal_user
PGPASSWORD=changeme

# Must match the TODO app's JWT_SECRET exactly (shared token verification)
JWT_SECRET=changeme_generate_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173
