# Copy to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=production

# PostgreSQL — same database as the TODO app
PGHOST=localhost
PGPORT=5432
PGDATABASE=todoapp
PGUSER=todoapp_user
PGPASSWORD=changeme

# Must match the TODO app's JWT_SECRET exactly (shared token verification)
JWT_SECRET=changeme_generate_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173
