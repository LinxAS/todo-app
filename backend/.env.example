# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=production

# PostgreSQL connection (matches your SUSE server: PostgreSQL 16, remote access enabled)
PGHOST=localhost
PGPORT=5432
PGDATABASE=todoapp
PGUSER=todoapp_user
PGPASSWORD=changeme

# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173
